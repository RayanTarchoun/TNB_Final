includes:
    - vendor/phpstan/phpstan-symfony/extension.neon
    - vendor/phpstan/phpstan-symfony/rules.neon
    - vendor/phpstan/phpstan-doctrine/extension.neon
    - vendor/phpstan/phpstan-doctrine/rules.neon

parameters:
    level: 6

    paths:
        - src/
        - tests/

    symfony:
        # Conteneur de l'environnement de test : c'est le seul qui expose
        # les services prives aux tests via static::getContainer(). Pointer
        # le conteneur "dev" ferait remonter de faux positifs
        # "Service ... is private" sur le code de test.
        containerXmlPath: var/cache/test/App_KernelTestDebugContainer.xml

    doctrine:
        objectManagerLoader: tests/object-manager.php
        # Les proprietes des entites sont typees nullables alors que les
        # colonnes sont NOT NULL : c'est le modele genere par MakerBundle.
        # Une entite fraichement instanciee (formulaire de creation) n'est pas
        # encore renseignee ; ce sont le Validator et les contraintes du SGBD
        # qui garantissent la non-nullite au moment de la persistance.
        allowNullablePropertyForRequiredField: true
