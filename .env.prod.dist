# Modele de configuration de production.
#
#   cp .env.prod.dist .env.prod   puis renseignez chaque valeur.
#
# .env.prod est ignore par Git (voir .gitignore) : aucun secret reel ne doit
# etre versionne. Ce fichier-ci, en revanche, est suivi : il documente les
# variables attendues sans en reveler la valeur.

# Chaine aleatoire de 32 caracteres. Generation :
#   php -r "echo bin2hex(random_bytes(16)), PHP_EOL;"
APP_SECRET=

# Mot de passe du compte root MySQL (administration du conteneur de base).
MYSQL_ROOT_PASSWORD=

# Mot de passe de l'utilisateur applicatif "tnb".
MYSQL_PASSWORD=

# URL publique de l'application, utilisee pour les liens des emails.
# Exemple : https://commandes.tarchoun.fr
DEFAULT_URI=

# Serveur d'envoi des emails de confirmation de commande.
# Exemple : smtp://utilisateur:motdepasse@smtp.exemple.fr:587
# Laisser "null://null" desactive tout envoi reel.
MAILER_DSN=null://null

# Cle de l'API meteo. A laisser vide sur l'offre gratuite d'Open-Meteo.
# Ne la renseignez que dans .env.prod, jamais dans un fichier versionne.
METEO_API_CLE=
