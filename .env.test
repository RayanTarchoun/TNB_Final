# Variables d'environnement de l'environnement de test.
#
# Rappel Symfony : .env.local n'est volontairement PAS charge en test, afin que
# la suite soit reproductible d'une machine a l'autre. Les surcharges propres a
# un poste (port MySQL par exemple) vont dans .env.test.local, non versionne.
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# Doctrine ajoute automatiquement le suffixe "_test" au nom de la base
# (config/packages/doctrine.yaml, section when@test) : la base de travail
# n'est jamais touchee par les tests.
DATABASE_URL="mysql://tnb:tnb@127.0.0.1:3306/tnb?serverVersion=8.0.36&charset=utf8mb4"

# Aucun email n'est reellement envoye pendant les tests.
MAILER_DSN=null://null

DEFAULT_URI=http://localhost
