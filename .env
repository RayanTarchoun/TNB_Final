# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=0da5fc74a56d006a833a48851f879620
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# En local (hors Docker) : 127.0.0.1. Sous Docker Compose, la variable est surchargee
# par le service "app" et pointe vers le conteneur "database".
DATABASE_URL="mysql://tnb:tnb@127.0.0.1:3306/tnb?serverVersion=8.0.36&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
# En developpement : null://null (aucun envoi reel).
# En production : smtp://user:pass@smtp.exemple.fr:587
MAILER_DSN=null://null
###< symfony/mailer ###

###> tnb/application ###
# URL publique de l'application, utilisee pour les liens des emails.
DEFAULT_URI=http://localhost:8000

# Adresse expeditrice des emails de confirmation de commande
MAIL_EXPEDITEUR=contact@tarchoun.fr
MAIL_EXPEDITEUR_NOM="Tarchoun Fruits & Legumes"

# Coordonnees du marche, utilisees par l'API meteo externe (Open-Meteo)
MARCHE_LATITUDE=48.8566
MARCHE_LONGITUDE=2.3522
MARCHE_LIEU="Place du Marche"
MARCHE_JOURS="Mercredi et Samedi"
MARCHE_HORAIRES="7h00 - 13h00"
MARCHE_TELEPHONE="01 23 45 67 89"

# API meteo externe (aucune cle requise)
METEO_API_URL=https://api.open-meteo.com/v1/forecast
###< tnb/application ###
