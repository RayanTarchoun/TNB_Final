{% extends 'admin/base.html.twig' %}

{% block title %}Stock de {{ stock.produit.nom }} — Back-office TNB{% endblock %}

{% block admin_corps %}
    <nav aria-label="Fil d'Ariane" class="mb-3">
        <ol class="breadcrumb small mb-0">
            <li class="breadcrumb-item"><a href="{{ path('app_admin_stock_index') }}">Stocks</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ stock.produit.nom }}</li>
        </ol>
    </nav>

    <h1 class="mb-4">Stock — {{ stock.produit.nom }}</h1>

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="tnb-bloc">
                {{ form_start(formulaire, {attr: {novalidate: 'novalidate'}}) }}
                    <div class="row g-3">
                        <div class="col-sm-6">{{ form_row(formulaire.quantiteAchetee) }}</div>
                        <div class="col-sm-6">{{ form_row(formulaire.quantiteDisponible) }}</div>
                    </div>
                    {{ form_row(formulaire.dateMarche) }}

                    <div class="d-flex flex-wrap gap-2 mt-4">
                        <button type="submit" class="btn btn-tnb">Enregistrer</button>
                        <a class="btn btn-outline-secondary" href="{{ path('app_admin_stock_index') }}">Annuler</a>
                    </div>
                {{ form_end(formulaire) }}
            </div>
        </div>

        <div class="col-lg-5">
            <div class="tnb-bloc tnb-bloc-accent">
                <h2 class="h6 mb-3">Etat actuel</h2>
                <dl class="row small mb-3">
                    <dt class="col-7">Unite de vente</dt>
                    <dd class="col-5 text-end">{{ stock.produit.uniteVente.libelle }}</dd>

                    <dt class="col-7">Deja reserve</dt>
                    <dd class="col-5 text-end">{{ stock.quantiteReservee|quantite }}</dd>

                    <dt class="col-7">Ecoulement</dt>
                    <dd class="col-5 text-end mb-0">{{ stock.pourcentageEcoule }} %</dd>
                </dl>

                <div class="tnb-jauge mb-3" role="img"
                     aria-label="{{ stock.pourcentageEcoule }} % du stock ecoule">
                    <div class="tnb-jauge-remplissage {{ stock.estEpuise ? 'epuise' }}"
                         style="width: {{ stock.pourcentageEcoule }}%;"></div>
                </div>

                <p class="small mb-0" style="color: var(--tnb-gris-texte);">
                    Derniere mise a jour : {{ stock.dateMiseAJour|date('d/m/Y à H:i') }}.
                    La quantite restante ne doit jamais depasser la quantite achetee.
                </p>
            </div>
        </div>
    </div>
{% endblock %}
