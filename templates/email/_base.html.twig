{# Gabarit commun des emails transactionnels.
   Les styles sont en ligne : les clients de messagerie ignorent
   massivement les feuilles de style externes. #}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block sujet %}Tarchoun Fruits &amp; Legumes{% endblock %}</title>
</head>
<body style="margin:0; padding:0; background-color:#fff8f0; font-family:'Segoe UI',Arial,sans-serif; color:#1a1a1a;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#fff8f0; padding:24px 12px;">
        <tr>
            <td align="center">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
                       style="max-width:600px; background-color:#ffffff; border-radius:12px; overflow:hidden; border:1px solid #e6ddd2;">
                    <tr>
                        <td style="background-color:#2c2c2c; padding:20px 24px;">
                            <span style="color:#e8741e; font-size:20px; font-weight:700; letter-spacing:0.04em;">TARCHOUN</span><br>
                            <span style="color:#d8d2ca; font-size:12px;">Fruits &amp; Legumes</span>
                        </td>
                    </tr>

                    <tr>
                        <td style="padding:24px;">
                            {% block contenu %}{% endblock %}
                        </td>
                    </tr>

                    <tr>
                        <td style="background-color:#2c2c2c; padding:18px 24px; color:#c8c1b8; font-size:12px; line-height:1.6;">
                            <strong style="color:#ffffff;">Retrait sur le marche</strong><br>
                            {{ marche_lieu }} — {{ marche_jours }}, {{ marche_horaires }}<br>
                            Tel : {{ marche_telephone }} — {{ mail_contact }}<br><br>
                            Paiement sur place uniquement : aucun reglement en ligne n'est demande.
                        </td>
                    </tr>
                </table>

                <p style="max-width:600px; color:#5c5349; font-size:11px; margin:16px auto 0; text-align:center;">
                    Vous recevez cet email car vous avez passe une commande sur le site
                    Tarchoun Fruits &amp; Legumes.
                </p>
            </td>
        </tr>
    </table>
</body>
</html>
