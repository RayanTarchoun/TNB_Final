{% extends 'base.html.twig' %}

{% block title %}Creer un compte — Tarchoun Fruits &amp; Legumes{% endblock %}

{% block corps %}
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-7">
            <div class="tnb-bloc">
                <h1 class="h3 mb-1">Creer mon compte client</h1>
                <p class="small mb-4" style="color: var(--tnb-gris-texte);">
                    Quelques informations suffisent : nous ne collectons que ce qui est
                    necessaire a la preparation de vos commandes.
                </p>

                {{ form_start(formulaire, {attr: {novalidate: 'novalidate'}}) }}
                    <div class="row g-3">
                        <div class="col-sm-6">{{ form_row(formulaire.prenom) }}</div>
                        <div class="col-sm-6">{{ form_row(formulaire.nom) }}</div>
                    </div>

                    {{ form_row(formulaire.email) }}
                    {{ form_row(formulaire.telephone) }}

                    <div class="row g-3">
                        <div class="col-sm-6">{{ form_row(formulaire.motDePasse.first) }}</div>
                        <div class="col-sm-6">{{ form_row(formulaire.motDePasse.second) }}</div>
                    </div>

                    <div class="mt-3">
                        {{ form_row(formulaire.accepterRgpd) }}
                        <p class="form-text mt-1">
                            Consultez notre
                            <a href="{{ path('app_confidentialite') }}">politique de confidentialite</a>.
                            Vous pourrez a tout moment modifier ou supprimer vos donnees depuis votre profil.
                        </p>
                    </div>

                    <button type="submit" class="btn btn-tnb w-100 mt-3">Creer mon compte</button>
                {{ form_end(formulaire) }}

                <hr class="my-4">

                <p class="text-center mb-0 small">
                    Vous avez deja un compte ?
                    <a href="{{ path('app_connexion') }}">Se connecter</a>
                </p>
            </div>
        </div>
    </div>
{% endblock %}
