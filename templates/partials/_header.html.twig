{# app.request peut etre nul si le gabarit est rendu hors cycle de requete
   (page d'erreur d'un sous-appel, rendu depuis la console) : le header ne
   doit jamais etre la cause d'une seconde erreur. #}
{% set route = app.request ? app.request.attributes.get('_route') : '' %}

<header class="tnb-header tnb-sans-impression">
    <nav class="navbar navbar-expand-lg container py-2" aria-label="Navigation principale">
        <a class="navbar-brand tnb-logo me-lg-4" href="{{ path('app_accueil') }}">
            TARCHOUN
            <small>Fruits &amp; Legumes</small>
        </a>

        <button class="navbar-toggler border-light" type="button"
                data-bs-toggle="collapse" data-bs-target="#navigationPrincipale"
                aria-controls="navigationPrincipale" aria-expanded="false"
                aria-label="Afficher ou masquer le menu">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navigationPrincipale">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item">
                    <a class="nav-link {{ route == 'app_accueil' ? 'actif' }}"
                       href="{{ path('app_accueil') }}"
                       {{ route == 'app_accueil' ? 'aria-current="page"' : '' }}>Accueil</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {{ route starts with 'app_produit' ? 'actif' }}"
                       href="{{ path('app_produit_index') }}"
                       {{ route starts with 'app_produit' ? 'aria-current="page"' : '' }}>Catalogue</a>
                </li>
                {% if is_granted('ROLE_CLIENT') %}
                    <li class="nav-item">
                        <a class="nav-link {{ route starts with 'app_commande' ? 'actif' }}"
                           href="{{ path('app_commande_historique') }}">Mes commandes</a>
                    </li>
                {% endif %}
                {% if is_granted('ROLE_ADMIN') %}
                    <li class="nav-item">
                        <a class="nav-link {{ route starts with 'app_admin' ? 'actif' }}"
                           href="{{ path('app_admin_dashboard') }}">Back-office</a>
                    </li>
                {% endif %}
            </ul>

            <ul class="navbar-nav align-items-lg-center gap-lg-1">
                <li class="nav-item">
                    {% set articles = panier_nombre_articles() %}
                    <a class="nav-link {{ route == 'app_panier' ? 'actif' }}" href="{{ path('app_panier') }}">
                        Panier
                        <span class="tnb-badge-panier ms-1">{{ articles }}</span>
                        <span class="visually-hidden">
                            {{ articles == 0 ? 'panier vide' : (articles == 1 ? '1 article' : articles ~ ' articles') }}
                        </span>
                    </a>
                </li>

                {% if app.user %}
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button"
                           data-bs-toggle="dropdown" aria-expanded="false">
                            {{ app.user.prenom }}
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <span class="dropdown-item-text small text-muted">{{ app.user.email }}</span>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="{{ path('app_profil') }}">Mon profil</a></li>
                            <li><a class="dropdown-item" href="{{ path('app_commande_historique') }}">Mes commandes</a></li>
                            {% if is_granted('ROLE_ADMIN') %}
                                <li><a class="dropdown-item" href="{{ path('app_admin_dashboard') }}">Back-office</a></li>
                            {% endif %}
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="{{ path('app_deconnexion') }}">Se deconnecter</a></li>
                        </ul>
                    </li>
                {% else %}
                    <li class="nav-item">
                        <a class="btn btn-tnb-secondaire btn-sm ms-lg-2 text-nowrap"
                           style="border-color: var(--tnb-orange); color: var(--tnb-orange);"
                           href="{{ path('app_connexion') }}">Connexion</a>
                    </li>
                {% endif %}
            </ul>
        </div>
    </nav>
</header>
